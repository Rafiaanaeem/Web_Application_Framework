
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - WAF Task 3</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }

    .login-box {
      background: white;
      padding: 30px;
      border-radius: 10px;
      width: 320px;
      box-shadow: 0 4px 15px #00000018;
    }

    h1 {
      text-align: center;
      color: #1e293b;
    }

    label {
      display: block;
      margin-top: 15px;
    }

    input {
      box-sizing: border-box;
      width: 100%;
      padding: 10px;
      margin-top: 6px;
    }

    button {
      width: 100%;
      padding: 11px;
      margin-top: 20px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .error {
      color: #dc2626;
      text-align: center;
    }

    .demo {
      margin-top: 20px;
      padding: 10px;
      background: #f8fafc;
      font-size: 13px;
      line-height: 1.7;
    }
  </style>
</head>
<body>
  <div class="login-box">
    <h1>Login</h1>
    <p style="text-align:center;">WAF Task 3 — Record Management</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">
      <label for="username">Username</label>
      <input
        type="text"
        id="username"
        name="username"
        required
      >

      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        required
      >

      <button type="submit">Login</button>
    </form>

    <div class="demo">
      <strong>Demo Accounts</strong><br>
      Admin: admin / Admin123!<br>
      Viewer: viewer / Viewer123!
    </div>
  </div>
</body>
</html>
