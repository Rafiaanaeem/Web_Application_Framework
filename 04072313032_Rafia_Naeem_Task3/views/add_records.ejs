
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Record - WAF Task 3</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      margin: 0;
      padding: 30px;
    }

    .form-container {
      max-width: 500px;
      margin: 20px auto;
      padding: 25px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 4px 15px #00000015;
    }

    h1 {
      text-align: center;
      color: #1e293b;
    }

    label {
      display: block;
      margin-top: 15px;
    }

    input, select {
      box-sizing: border-box;
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      border: 1px solid #cbd5e1;
      border-radius: 5px;
    }

    button, a {
      display: inline-block;
      margin-top: 20px;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      text-decoration: none;
      cursor: pointer;
      font-size: 14px;
    }

    button {
      background: #2563eb;
      color: white;
    }

    a {
      background: #e2e8f0;
      color: #1e293b;
      margin-left: 8px;
    }
  </style>
</head>
<body>
  <div class="form-container">
    <h1>Add Employee Record</h1>

    <form action="/records/add" method="POST">
      <label for="first_name">First Name</label>
      <input
        type="text"
        id="first_name"
        name="first_name"
        required
      >

      <label for="last_name">Last Name</label>
      <input
        type="text"
        id="last_name"
        name="last_name"
        required
      >

      <label for="gender">Gender</label>
      <select id="gender" name="gender" required>
        <option value="">Select Gender</option>
        <option value="Male">Male</option>
        <option value="Female">Female</option>
        <option value="Other">Other</option>
      </select>

      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
      >

      <button type="submit">Add Record</button>
      <a href="/records">Cancel</a>
    </form>
  </div>
</body>
</html>
