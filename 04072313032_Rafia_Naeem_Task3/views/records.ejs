
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Records - WAF Task 3</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      background: #f8fafc;
      color: #1e293b;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    a, button {
      display: inline-block;
      padding: 9px 13px;
      border: none;
      border-radius: 5px;
      text-decoration: none;
      cursor: pointer;
      font-size: 14px;
    }

    .primary {
      background: #2563eb;
      color: white;
    }

    .secondary {
      background: #475569;
      color: white;
    }

    .edit {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .delete {
      background: #fee2e2;
      color: #b91c1c;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      margin-top: 25px;
    }

    th, td {
      border: 1px solid #e2e8f0;
      padding: 12px;
      text-align: left;
    }

    th {
      background: #e2e8f0;
    }

    .inline-form {
      display: inline;
    }

    .empty {
      text-align: center;
      padding: 25px;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div>
      <h1>Employee Records</h1>
      <p>
        Logged in as:
        <strong><%= user.username %></strong>
        (<%= user.role %>)
      </p>
    </div>

    <div class="actions">
      <% if (user.role === 'admin') { %>
        <a href="/records/add" class="primary">Add Record</a>
      <% } %>

      <form action="/logout" method="POST" class="inline-form">
        <button type="submit" class="secondary">Logout</button>
      </form>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Gender</th>
        <th>Email</th>
        <% if (user.role === 'admin') { %>
          <th>Actions</th>
        <% } %>
      </tr>
    </thead>

    <tbody>
      <% if (records.length === 0) { %>
        <tr>
          <td colspan="<%= user.role === 'admin' ? 6 : 5 %>" class="empty">
            No records found.
          </td>
        </tr>
      <% } %>

      <% records.forEach(function(record) { %>
        <tr>
          <td><%= record.id %></td>
          <td><%= record.first_name %></td>
          <td><%= record.last_name %></td>
          <td><%= record.gender %></td>
          <td><%= record.email %></td>

          <% if (user.role === 'admin') { %>
            <td>
              <a
                href="/records/<%= record.id %>/edit"
                class="edit"
              >Edit</a>

              <form
                action="/records/<%= record.id %>/delete"
                method="POST"
                class="inline-form"
                onsubmit="return confirm('Are you sure you want to remove this record?');"
              >
                <button type="submit" class="delete">Remove</button>
              </form>
            </td>
          <% } %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
